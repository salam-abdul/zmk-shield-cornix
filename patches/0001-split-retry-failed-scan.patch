--- a/app/src/split/bluetooth/central.c
+++ b/app/src/split/bluetooth/central.c
@@ -35,6 +35,14 @@
 #include <zmk/physical_layouts.h>
 
 static int start_scanning(void);
+
+// A failed scan start must not permanently disable split reconnection.
+static void retry_scanning_work_cb(struct k_work *work) {
+    ARG_UNUSED(work);
+    start_scanning();
+}
+
+static K_WORK_DELAYABLE_DEFINE(retry_scanning_work, retry_scanning_work_cb);
 
 #define POSITION_STATE_DATA_LEN 16
 
@@ -910,11 +918,14 @@
     // Start scanning otherwise.
     is_scanning = true;
     int err = bt_le_scan_start(BT_LE_SCAN_PASSIVE, split_central_device_found);
-    if (err < 0) {
-        LOG_ERR("Scanning failed to start (err %d)", err);
+    if (err < 0 && err != -EALREADY) {
+        is_scanning = false;
+        LOG_ERR("Scanning failed to start (err %d), retrying in 1 second", err);
+        k_work_reschedule(&retry_scanning_work, K_SECONDS(1));
         return err;
     }
 
+    k_work_cancel_delayable(&retry_scanning_work);
     LOG_DBG("Scanning successfully started");
     return 0;
 }
