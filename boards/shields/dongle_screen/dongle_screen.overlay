/*
 * Zephyr 4.1 rewrite: the stock sitronix,st7789v driver moved to the MIPI-DBI
 * subsystem, so the panel now sits under a zephyr,mipi-dbi-spi controller node
 * (spi-dev + dc/reset gpios) instead of directly on the SPI bus. CS stays on the
 * SPI controller. DC is ACTIVE_HIGH here (the MIPI-DBI driver drives logic-high
 * for data); RESET stays ACTIVE_LOW.
 */
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
   pwmleds {
      compatible = "pwm-leds";
      disp_bl: pwm_led_1 {
          pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
      };
   };

   chosen {
      zephyr,display = &st7789;
   };

   mipi_dbi_disp: mipi-dbi {
      compatible = "zephyr,mipi-dbi-spi";
      spi-dev = <&spi3>;
      dc-gpios = <&xiao_d 7 GPIO_ACTIVE_HIGH>;
      reset-gpios = <&xiao_d 3 GPIO_ACTIVE_LOW>;
      write-only;
      #address-cells = <1>;
      #size-cells = <0>;

      st7789: st7789v@0 {
          compatible = "sitronix,st7789v";
          reg = <0>;
          mipi-max-frequency = <31000000>;
          mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
          width = <240>;
          height = <280>;
          x-offset = <0>;
          y-offset = <20>;
          vcom = <0x19>;
          gctrl = <0x35>;
          vrhs = <0x12>;
          vdvs = <0x20>;
          mdac = <0x00>;
          gamma = <0x01>;
          colmod = <0x05>;
          lcm = <0x2c>;
          porch-param = [ 0c 0c 00 33 33 ];
          cmd2en-param = [ 5a 69 02 01 ];
          pwctrl1-param = [ a4 a1 ];
          pvgam-param = [ D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23 ];
          nvgam-param = [ D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23 ];
          ram-param = [ 00 F0 ];
          rgb-param = [ CD 08 14 ];
      };
   };
};

&spi2 {
   status = "disabled";
};

&pinctrl {
   spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 10)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 10)>;
			low-power-enable;
		};
	};

   pwm1_default: pwm1_default {
      group1 {
         psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
         nordic,invert;
      };
   };

   pwm1_sleep: pwm1_sleep {
      group1 {
         psels = <NRF_PSEL(PWM_OUT0, 1, 11)>;
         low-power-enable;
      };
   };
};

&spi3 {
   status = "okay";
   pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
   cs-gpios = <&xiao_d 9 GPIO_ACTIVE_LOW>;
};

/*
 * The APDS9960 ambient-light sensor (optional, CONFIG_DONGLE_SCREEN_AMBIENT_LIGHT,
 * default n) is intentionally omitted: enabling &i2c0 on the Zephyr 4.1 xiao_ble
 * requires an explicit pinctrl, and the display does not need it. Re-add &i2c0
 * (with pinctrl-0/pinctrl-names) plus the apds9960 node if you enable that option.
 */

&pwm1 {
  status = "okay";
  pinctrl-0 = <&pwm1_default>;
  pinctrl-1 = <&pwm1_sleep>;
  pinctrl-names = "default", "sleep";
};
