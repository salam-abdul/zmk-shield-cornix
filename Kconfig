# Workaround: zmk-keyboard-cornix Zephyr 4.1 migration is missing ZMK_BOARD_COMPAT
# in Kconfig.cornix_right / Kconfig.cornix_ph_left. Remove once upstream adds:
#   select ZMK_BOARD_COMPAT if BOARD_<BOARD>_NRF52840_ZMK
# to those files (mirroring what ZMK does for xiao_ble in Kconfig.xiao_ble).

config BOARD_CORNIX_RIGHT
	select ZMK_BOARD_COMPAT if BOARD_CORNIX_RIGHT_NRF52840_ZMK

config BOARD_CORNIX_PH_LEFT
	select ZMK_BOARD_COMPAT if BOARD_CORNIX_PH_LEFT_NRF52840_ZMK
